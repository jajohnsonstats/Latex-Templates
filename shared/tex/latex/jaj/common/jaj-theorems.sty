\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jaj-theorems}[2026/09/25 Theorem-like environments]

%% Usage (papers, reports, notes -- not beamer, see below):
%%   \usepackage{amsthm}
%%   \usepackage{hyperref}
%%   \usepackage{cleveref}
%%   \usepackage{jaj-theorems}             % numbered 3.1, 3.2, ... (default)
%%   \usepackage[flat]{jaj-theorems}       % numbered 1, 2, 3, ...
%%
%% LOAD ORDER:  amsthm  ->  hyperref  ->  cleveref  ->  jaj-theorems
%% All environments share one counter. cleveref can only tell a Lemma
%% from a Theorem on a shared counter if (a) amsthm is loaded BEFORE
%% cleveref, so cleveref can patch \newtheorem, and (b) the environments
%% are defined AFTER cleveref. Get either wrong and \cref{lem:x} prints
%% "Theorem". Both mistakes are caught below.

%% ---------------------------- OPTIONS -----------------------------
\newif\ifjajthm@flat
\DeclareOption{flat}{\jajthm@flattrue}
\DeclareOption{section}{\jajthm@flatfalse}
\ProcessOptions\relax

%% ------------------------- SAFETY CHECKS --------------------------
%% (a) cleveref present but amsthm missing: cleveref never patched it.
\@ifpackageloaded{cleveref}{%
  \@ifpackageloaded{amsthm}{}{%
    \PackageError{jaj-theorems}{amsthm must be loaded before cleveref}{%
      Add \string\usepackage{amsthm} before hyperref and cleveref.
      Otherwise \string\cref\space labels every environment "Theorem".}}%
}{}
\RequirePackage{amsthm}

%% Beamer defines theorem, lemma, definition, ... itself. Loading this
%% file there needs \documentclass[notheorems]{beamer}.
\@ifclassloaded{beamer}{%
  \@ifundefined{theorem}{}{%
    \PackageError{jaj-theorems}{Beamer already defines theorem environments}{%
      Use \string\documentclass[notheorems]{beamer} to load jaj-theorems.sty,
      or drop jaj-theorems.sty and use beamer's built-in environments.}%
    \endinput}%
}{}

%% (b) Warn if cleveref turns up after this file (lemmas would be labelled
%% "Theorem" by \cref).
\newif\ifjajthm@crefbefore
\@ifpackageloaded{cleveref}{\jajthm@crefbeforetrue}{\jajthm@crefbeforefalse}
\AtBeginDocument{%
  \ifjajthm@crefbefore\else
    \@ifpackageloaded{cleveref}{%
      \PackageWarningNoLine{jaj-theorems}{cleveref was loaded after jaj-theorems.sty.
        \MessageBreak Load jaj-theorems.sty after cleveref so \string\cref\space
        \MessageBreak names shared-counter environments correctly}%
    }{}%
  \fi}

%% ------------------------------ STYLES ----------------------------
%% Stated results: italic body.
\newtheoremstyle{jacobplain}
  {2mm}        % Space above
  {1mm}        % Space below
  {\itshape}   % Body font
  {}           % Indent
  {\scshape}   % Head font
  {.}          % Punctuation after head
  {.5em}       % Space after head
  {}           % Head spec

%% Definitions, assumptions, examples, remarks: upright body.
\newtheoremstyle{jacobdefinition}
  {2mm}{1mm}{\normalfont}{}{\scshape}{.}{.5em}{}

%% ------------------------- ENVIRONMENTS ---------------------------
%% One shared counter ("theorem"), so Lemma 3.2 follows Theorem 3.1.
\theoremstyle{jacobplain}
\ifjajthm@flat
  \newtheorem{theorem}{Theorem}
\else
  \newtheorem{theorem}{Theorem}[section]
\fi
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{claim}[theorem]{Claim}

\theoremstyle{jacobdefinition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem{example}[theorem]{Example}
\newtheorem{remark}[theorem]{Remark}

%% Unnumbered variants, e.g. for restating a known result.
\theoremstyle{jacobplain}
\newtheorem*{theorem*}{Theorem}
\newtheorem*{lemma*}{Lemma}
\theoremstyle{jacobdefinition}
\newtheorem*{remark*}{Remark}

\theoremstyle{plain}   % restore the amsthm default for anything defined later

%% ---------------------- CLEVEREF NAMES ----------------------------
%% cleveref has built-in names for most of these; claim and assumption
%% it does not. Set here (only if cleveref is already loaded), so a
%% \crefname in your own preamble after this file still wins.
\ifjajthm@crefbefore
  \crefname{theorem}{Theorem}{Theorems}%
  \crefname{lemma}{Lemma}{Lemmas}%
  \crefname{proposition}{Proposition}{Propositions}%
  \crefname{corollary}{Corollary}{Corollaries}%
  \crefname{claim}{Claim}{Claims}%
  \crefname{definition}{Definition}{Definitions}%
  \crefname{assumption}{Assumption}{Assumptions}%
  \crefname{example}{Example}{Examples}%
  \crefname{remark}{Remark}{Remarks}
\fi

\endinput
