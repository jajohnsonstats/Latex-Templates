%% ---------------------- SETS, NORMS, INNER PRODUCTS ---------------
%% Paired delimiters (mathtools). Three sizing forms for each:
%%   \norm{x}          normal size (default)
%%   \norm*{x}         auto-sized, i.e. \left ... \right
%%   \norm[\big]{x}    manual size: \big, \Big, \bigg, \Bigg
\DeclarePairedDelimiter{\set}{\{}{\}}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiterX{\inner}[2]{\langle}{\rangle}{#1,\, #2}

%% Set-builder notation with a sized middle bar:
%%   \setbuilder{x \in \domain}{f(x) > 0}   ->  { x in D | f(x) > 0 }
\DeclarePairedDelimiterX{\setbuilder}[2]{\{}{\}}{#1 \;\delimsize\vert\; #2}

